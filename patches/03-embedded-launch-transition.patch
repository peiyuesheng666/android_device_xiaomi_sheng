+    /**
+     * Keep an embedded placeholder opening from ending an unrelated task launch early.
+     * This policy is scoped to sheng and its Quickstep launch transition.
+     */
+    private static boolean shouldDeferEmbeddedLaunch(@NonNull RemoteTransition remote,
+            @NonNull TransitionInfo info) {
+        if (!"sheng".equals(Build.DEVICE)
+                || !"QuickstepLaunch".equals(remote.getDebugName())
+                || info.getType() != WindowManager.TRANSIT_OPEN) {
+            return false;
+        }
+        boolean embeddedOpening = false;
+        for (TransitionInfo.Change change : info.getChanges()) {
+            final boolean embedded = change.hasFlags(
+                    TransitionInfo.FLAG_IN_TASK_WITH_EMBEDDED_ACTIVITY);
+            final boolean stationary = change.getStartAbsBounds().equals(change.getEndAbsBounds())
+                    && change.getStartDisplayId() == change.getEndDisplayId();
+            if (embedded && change.getMode() == WindowManager.TRANSIT_OPEN) {
+                embeddedOpening = true;
+            } else if (change.getMode() != WindowManager.TRANSIT_CHANGE
+                    || (!embedded && !stationary)) {
+                // Back, another task launch, rotation and resize still interrupt normally.
+                return false;
+            }
+        }
+        return embeddedOpening;
+    }
