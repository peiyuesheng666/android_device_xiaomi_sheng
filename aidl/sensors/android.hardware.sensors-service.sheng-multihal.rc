# Persist is mounted in fs. Finish calibration conversion before late-fs
# starts sscrpcd, which loads SSC's registry and orientation configurations.
on post-fs
    exec_start vendor.sheng-sensor-frame

service vendor.sheng-sensor-frame /vendor/bin/hw/android.hardware.sensors-service.sheng-multihal --migrate-landscape-frame
    user system
    group system
    disabled
    oneshot

service vendor.sensors-hal-multihal /vendor/bin/hw/android.hardware.sensors-service.sheng-multihal
    override
    interface aidl android.hardware.sensors.ISensors/default
    class hal
    user system
    group system wakelock context_hub input uhid
    task_profiles ServiceCapacityLow
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
    socket audio_us_socket_1 seqpacket 0666 system system
