// SPDX-License-Identifier: Apache-2.0
java_library {
    name: "ShengPenChargeSupport",
    srcs: ["common/**/*.java"],
    installable: false,
    product_specific: true,
}

android_app {
    name: "ShengPenSettings",
    srcs: ["src/**/*.java"],
    static_libs: ["ShengPenChargeSupport"],
    certificate: "platform",
    platform_apis: true,
    min_sdk_version: "1",
    target_sdk_version: "37",
    product_specific: true,
    optimize: {
        // The API 1 entry deliberately reaches the modern class through reflection.
        proguard_flags_files: ["proguard.flags"],
    },
}
