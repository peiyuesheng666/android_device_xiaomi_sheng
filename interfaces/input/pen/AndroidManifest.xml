<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.sheng.pen" android:versionCode="17" android:versionName="1.16-test">
    <uses-sdk android:minSdkVersion="1" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="org.lineageos.sheng.stylus.READ_CHARGING" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <queries>
        <package android:name="org.lineageos.sheng.keyboard" />
        <provider android:authorities="org.lineageos.sheng.stylus.charging" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_accessories"
        android:theme="@style/ShengPenTheme" android:allowBackup="false">
        <activity android:name=".AccessorySettingsActivity" android:exported="true" android:label="@string/accessories_title">
            <intent-filter><action android:name="com.android.settings.action.EXTRA_SETTINGS" /></intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.connect" />
            <meta-data android:name="com.android.settings.order" android:value="-40" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/accessories_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/accessories_summary" />
            <meta-data android:name="com.android.settings.icon" android:resource="@drawable/ic_accessories" />
            <meta-data android:name="com.android.settings.icon_tintable" android:value="true" />
        </activity>
        <activity android:name=".CompatibilityActivity" android:exported="true" />
        <activity android:name=".PenSettingsActivity" android:exported="false" />
    </application>
</manifest>
