# SPDX-License-Identifier: Apache-2.0
type vendor_sheng_stylus, domain;
type vendor_sheng_stylus_exec, exec_type, vendor_file_type, file_type;
type vendor_sheng_stylus_runtime_file, file_type;
type hal_sheng_stylus_service, hal_service_type, service_manager_type;
init_daemon_domain(vendor_sheng_stylus)
binder_use(vendor_sheng_stylus)
add_service(vendor_sheng_stylus, hal_sheng_stylus_service)
binder_call(sheng_stylus_app, vendor_sheng_stylus)
allow sheng_stylus_app hal_sheng_stylus_service:service_manager find;

allow vendor_sheng_stylus device:dir r_dir_perms;
allow vendor_sheng_stylus input_device:dir r_dir_perms;
allow vendor_sheng_stylus input_device:chr_file { getattr open read write ioctl };
allowxperm vendor_sheng_stylus input_device:chr_file ioctl { 0x4502 0x4506 0x4508 0x4521 0x4522 };
allow vendor_sheng_stylus vendor_hidraw_device:chr_file { getattr open read ioctl };
allowxperm vendor_sheng_stylus vendor_hidraw_device:chr_file ioctl { 0x4801 0x4802 0x4803 0x4804 0x4808 };
allow vendor_sheng_stylus touchfeature_device:chr_file { getattr open read write ioctl };
allowxperm vendor_sheng_stylus touchfeature_device:chr_file ioctl { 0x5400 0x5403 };
allow vendor_sheng_stylus vendor_sysfs_sheng_touch_dpms:file r_file_perms;
allow vendor_sheng_stylus sysfs:dir search;
allow vendor_sheng_stylus self:unix_stream_socket create_stream_socket_perms;
allow vendor_sheng_stylus vendor_sheng_touch_report:unix_stream_socket connectto;
allow vendor_sheng_stylus vendor_sheng_stylus_runtime_file:dir { search open read write getattr add_name remove_name };
allow vendor_sheng_stylus vendor_sheng_stylus_runtime_file:file { create open read write getattr unlink };
allow init vendor_sheng_stylus_runtime_file:dir { create setattr relabelto };
r_dir_file(sheng_stylus_app, vendor_sysfs_battery_supply)
allow sheng_stylus_app sysfs:dir search;
