typeattribute sheng_stylus_app coredomain, mlstrustedsubject;
app_domain(sheng_stylus_app)
binder_service(sheng_stylus_app)
binder_use(sheng_stylus_app)
binder_call(sheng_stylus_app, system_server)
binder_call(sheng_stylus_app, bluetooth)
allow sheng_stylus_app { app_api_service system_api_service }:service_manager find;
allow sheng_stylus_app self:netlink_kobject_uevent_socket { create bind read getattr setopt };

type sheng_stylus_app_data_file, file_type, data_file_type, core_data_file_type, app_data_file_type;
allow sheng_stylus_app sheng_stylus_app_data_file:dir create_dir_perms;
allow sheng_stylus_app sheng_stylus_app_data_file:{ file lnk_file } create_file_perms;
