<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.sheng.stylus" android:sharedUserId="android.uid.system"
    android:versionCode="16" android:versionName="1.15-test">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="37" />
    <permission android:name="org.lineageos.sheng.stylus.READ_CHARGING" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.LOCAL_MAC_ADDRESS" />
    <uses-permission android:name="android.permission.DISABLE_INPUT_DEVICE" />
    <uses-permission android:name="android.permission.RESTRICT_DISPLAY_MODES" />
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.MONITOR_INPUT" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
    <application android:name=".ShengStylusApplication" android:label="Stylus connection service"
        android:persistent="true" android:directBootAware="true" android:allowBackup="false">
        <provider android:name=".PenChargeProvider" android:authorities="org.lineageos.sheng.stylus.charging"
            android:exported="true" android:permission="org.lineageos.sheng.stylus.READ_CHARGING" />
    </application>
</manifest>
