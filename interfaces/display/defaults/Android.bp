// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["sheng_display_defaults_license"],
}
license {
    name: "sheng_display_defaults_license",
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}
android_app {
    name: "ShengDisplayDefaults",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    min_sdk_version: "33",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    required: ["privapp-permissions-org.lineageos.sheng.displaydefaults.xml"],
    optimize: { enabled: false },
}

prebuilt_etc {
    name: "privapp-permissions-org.lineageos.sheng.displaydefaults.xml",
    product_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-org.lineageos.sheng.displaydefaults.xml",
}
