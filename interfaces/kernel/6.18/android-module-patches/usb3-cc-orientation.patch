erty = XM_PROP_CC_ORIENTATION,\n+\t};\n+\tu32 value;\n+\tint ret;\n+\n+\tif (!orientation)\n+\t\treturn -EINVAL;\n+\tif (!of_root || of_property_match_string(of_root, "model",\n+\t\t\t"Qualcomm Technologies, Inc. 8550 sheng") < 0)\n+\t\treturn -ENODEV;\n+\t/* This owner is published only for the verified sheng panel identity.\n+\t * Removal takes the same lock before releasing the GLINK transport.\n+\t */\n+\tmutex_lock(&sheng_keyboard_charger_lock);\n+\tret = sheng_keyboard_bcdev ?\n+\t\tsheng_pogo_transfer(sheng_keyboard_bcdev, &request, 0, &value) :\n+\t\t-ENODEV;\n+\tif (!ret) {\n+\t\t/* Never reuse a cached pre-disconnect direction or guess CC2. */\n+\t\tif (value == 1 || value == 2)\n+\t\t\t*orientation = value;\n+\t\telse\n+\t\t\tret = value == 0 ? -ENODATA : -EPROTO;\n+\t}\n+\tmutex_unlock(&sheng_keyboard_charger_lock);\n+\treturn ret;\n+}\n+EXPORT_SYMBOL_GPL(sheng_usb_get_cc_orientation);\n--- /dev/null\n+++ b/soc/drivers/power/supply/sheng_usb_cc_readiness.h\n@@ -0,0 +1,49 @@\n+/* SPDX-License-Identifier: GPL-2.0-only */\n+/* A class directory alone predates publication of the firmware API owner. */\n+static ssize_t sheng_usb_cc_owner_ready_show(const struct class *class,\n+\t\tconst struct class_attribute *attr, char *buf)\n+{\n+\tstruct battery_chg_dev *bcdev = container_of(class,\n+\t\t\tstruct battery_chg_dev, battery_class);\n+\tbool ready;\n+\n+\tmutex_lock(&sheng_keyboard_charger_lock);\n+\tready = sheng_keyboard_bcdev == bcdev &&\n+\t\tREAD_ONCE(bcdev->initialized) &&\n+\t\tatomic_read(&bcdev->state) == PMIC_GLINK_STATE_UP;\n+\tmutex_unlock(&sheng_keyboard_charger_lock);\n+\treturn sysfs_emit(buf, "%u\\n", ready);\n+}\n+static CLASS_ATTR_RO(sheng_usb_cc_owner_ready);\n+\n+static ssize_t sheng_usb_cc_fresh_orientation_show(const struct class *class,\n+\t\tconst struct class_attribute *attr, char *buf)\n+{\n+\tint cc, ret;\n+\n+\t/* Owner publication alone can precede a nonzero firmware polarity.\n+\t * Use the same matched, non-cached request and li