--- a/soc/drivers/usb/dwc3/dwc3-msm-core.c
+++ b/soc/drivers/usb/dwc3/dwc3-msm-core.c
@@ -7470,6 +7470,11 @@
 		atomic_read(&mdwc->dev->power.usage_count));
 
 	if (on) {
+		bool sheng_delay_vbus = !IS_ERR_OR_NULL(mdwc->redriver) &&
+			dwc3_msm_get_max_speed(mdwc) >= USB_SPEED_SUPER &&
+			of_root && of_property_match_string(of_root, "model",
+				"Qualcomm Technologies, Inc. 8550 sheng") >= 0;
+
 		dev_dbg(mdwc->dev, "%s: turn on gadget\n", __func__);
 
 		if (mdwc->wcd_usbss)
@@ -7486,11 +7491,18 @@
 			flush_work(&dwc->drd_work);
 		dwc3_msm_notify_event(dwc, DWC3_GSI_EVT_BUF_SETUP, 0);
 
-		dwc3_override_vbus_status(mdwc, true);
+		/* On sheng the PS5169 programs the SS lane synchronously. Do not
+		 * advertise lane power to the controller before its path is ready.
+		 * Keep the original ordering for all other boards.
+		 */
+		if (!sheng_delay_vbus)
+			dwc3_override_vbus_status(mdwc, true);
 
 		usb_redriver_notify_connect(mdwc->redriver,
 				mdwc->typec_orientation & PHY_LANE_A ?
 				ORIENTATION_CC1 : ORIENTATION_CC2);
+		if (sheng_delay_vbus)
+			dwc3_override_vbus_status(mdwc, true);
 		if (dwc3_msm_get_max_speed(mdwc) >= USB_SPEED_SUPER)
 			usb_phy_notify_connect(mdwc->ss_phy, USB_SPEED_SUPER);
 
