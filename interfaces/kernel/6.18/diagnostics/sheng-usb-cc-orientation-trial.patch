 	mdwc->has_orientation_gpio = true;
 }
 
+/* The UCSI role callback does not carry cable polarity.  On sheng,
+ * obtain a fresh matched firmware reply before PHY init/resume.  symbol_get
+ * keeps the optional provider alive without a hard module-load dependency.
+ */
+extern int sheng_usb_get_cc_orientation(int *orientation);
+
+static int sheng_dwc3_cc_orientation(struct dwc3_msm *mdwc)
+{
+	int (*get_orientation)(int *);
+	int cc, ret;
+
+	if (!of_root || of_property_match_string(of_root, "model",
+			"Qualcomm Technologies, Inc. 8550 sheng") < 0)
+		return -ENODEV;
+	mdwc->typec_orientation = 0;
+	get_orientation = symbol_get(sheng_usb_get_cc_orientation);
+	if (!get_orientation)
+		return -ENODEV;
+	ret = get_orientation(&cc);
+	symbol_put(sheng_usb_get_cc_orientation);
+	if (ret) {
+		dev_warn_ratelimited(mdwc->dev,
+			"sheng: CC orientation unavailable: %d\n", ret);
+		return ret;
+	}
+	if (cc != 1 && cc != 2)
+		return -EPROTO;
+	dev_info_ratelimited(mdwc->dev, "sheng: firmware CC%d to SS PHY\n", cc);
+	return cc == 1 ? PHY_LANE_A : PHY_LANE_B;
+}
+
 static void dwc3_set_ssphy_orientation_flag(struct dwc3_msm *mdwc)
 {
 	union extcon_property_value val;
@@ -3935,6 +3966,9 @@
 				orientation = val.intval ? PHY_LANE_B : PHY_LANE_A;
 		}
 	}
+
+	if (orientation < 0)
+		orientation = sheng_dwc3_cc_orientation(mdwc);
 
 	if (orientation < 0)
 		return;
