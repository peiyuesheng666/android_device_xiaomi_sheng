+
+/* Called after continuous-splash setup and DRM registration, in process
+ * context. Re-enable the saved LEDs without remapping bootloader brightness.
+ * Normal brightness updates or a reset cancel the saved-state restoration. */
+void sheng_ktz8866_splash_ready(void)
+{
+	struct ktz8866_led *ktz;
+	int ret;
+
+	mutex_lock(&ktz8866_dev_list_mutex);
+	list_for_each_entry(ktz, &ktz8866_dev_list, entry) {
+		if (!ktz->boot_guard_held)
+			continue;
+		ret = regmap_write(ktz->regmap, KTZ8866_DISP_BL_ENABLE,
+			ktz->boot_enable);
+		if (ret) {
+			dev_warn(ktz->dev, "splash LED restoration failed: %d\n", ret);
+			continue;
+		}
+		ktz->boot_guard_held = false;
+		ktz->ktz8866_status = !!(ktz->boot_enable & KTZ8866_backlight_EN_MASK);
+		dev_info(ktz->dev, "sheng splash LEDs restored\n");
+	}
+	mutex_unlock(&ktz8866_dev_list_mutex);
 }
 
