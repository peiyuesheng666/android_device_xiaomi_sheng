 MODULE_DEVICE_TABLE(of, disp_cc_kalama_match_table);
 
+/* Read only control/configuration registers while the iface clock is on.
+ * None of these registers clears status on read. No panel or timing writes. */
+static void sheng_dispcc_trace(struct device *dev, const char *stage)
+{
+	static const unsigned int regs[] = {
+		0x0, 0x4, 0x10, 0x18, 0x1000, 0x1004, 0x1010, 0x1018,
+		0x8004, 0x8008, 0x800c, 0x8018, 0x8024,
+		0x8028, 0x802c, 0x8030, 0x8034, 0x80a4,
+		0x80a8, 0x80ac, 0x80c0, 0x80c4, 0x80d8, 0x80dc,
+		0x8108, 0x810c, 0x8124, 0x8128, 0x9000, 0xf000,
+	};
+	struct regmap *map = dev_get_regmap(dev, NULL);
+	unsigned int value;
+	int i;
+
+	if (!map)
+		return;
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		if (!regmap_read(map, regs[i], &value))
+			dev_info(dev, "sheng_dispcc: %s %04x=%08x\n",
+				stage, regs[i], value);
+}
+
 static int disp_cc_kalama_probe(struct platform_device *pdev)
 {
 	struct regmap *regmap;
