+/* The caller already holds the display power vote. These are read-only
+ * timing registers, not interrupt/status-clear registers. Capture both DSI
+ * interfaces to compare bootloader scanout with the first Linux mode. */
+void sheng_intf_handoff_trace(struct sde_hw_intf *intf, const char *stage)
+{
+	struct sde_hw_blk_reg_map *c;
+
+	if (!intf || !intf->cap || intf->cap->type != INTF_DSI)
+		return;
+	c = &intf->hw;
+	pr_info("sheng_handoff: %s intf=%u en=%x cfg=%x hsync=%x vperiod=%x vpulse=%x hdisplay=%x vstart=%x vend=%x cfg2=%x data_h=%x\n",
+		stage, intf->idx,
+		SDE_REG_READ(c, INTF_TIMING_ENGINE_EN),
+		SDE_REG_READ(c, INTF_CONFIG),
+		SDE_REG_READ(c, INTF_HSYNC_CTL),
+		SDE_REG_READ(c, INTF_VSYNC_PERIOD_F0),
+		SDE_REG_READ(c, INTF_VSYNC_PULSE_WIDTH_F0),
+		SDE_REG_READ(c, INTF_DISPLAY_HCTL),
+		SDE_REG_READ(c, INTF_DISPLAY_V_START_F0),
+		SDE_REG_READ(c, INTF_DISPLAY_V_END_F0),
+		SDE_REG_READ(c, INTF_CONFIG2),
+		SDE_REG_READ(c, INTF_DISPLAY_DATA_HCTL));
+}
