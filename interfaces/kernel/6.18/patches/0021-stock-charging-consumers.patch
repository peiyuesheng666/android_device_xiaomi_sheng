+		ret = charger_enable_keyboard_ovp(bq, enable);
+		if (ret < 0) {
+			main_err("%s: close kb_ovp_en_gpio[%d] is failed\n", __func__,
+					bq->kb_ovp_en_gpio);
+			return -EINVAL;
+		}
+	}
+
+	return ret;
+}
