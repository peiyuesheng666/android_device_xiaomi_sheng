+static int bq_battery_soc_smooth_tracking_new(struct dual_fg_chip *bq,int soc)
+{
+	int rc;
+	static int system_soc,last_system_soc;
+	int status = 0,temp;
+	int unit_time = 10000, delta_time = 0,soc_delta = 0;
+	int change_delta = 0;
