+static int battery_psy_set_charge_current(struct battery_chg_dev *bcdev, int val)
+{
+ struct battmngr_notify *data;
+ int ret, cookie, previous;
+ if (!bcdev->num_thermal_levels) return 0;
+ if (bcdev->num_thermal_levels < 0 || val < 0 || val >= bcdev->num_thermal_levels)
+  return -EINVAL;
+ if (READ_ONCE(bcdev->sheng_fg.pogo)) {
+  data = battmngr_notify_acquire(&cookie);
+  if (!data) return -ENODEV;
+  mutex_lock(&data->notify_lock);
+  previous = data->misc_msg.thermal_level;
+  data->misc_msg.thermal_level = val;
+  ret = notifier_to_errno(battmngr_notifier_call_chain(BATTMNGR_EVENT_THERMAL, data));
+  if (ret) data->misc_msg.thermal_level = previous;
+  mutex_unlock(&data->notify_lock);
+  battmngr_notify_release(cookie);
+ } else {
+  ret = write_property_id(bcdev, &bcdev->psy_list[PSY_TYPE_BATTERY], BATT_CHG_CTRL_LIM, val);
+ }
+ if (!ret) bcdev->curr_thermal_level = val;
+ return ret;
 }
 
