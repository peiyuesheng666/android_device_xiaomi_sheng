+static int xm_get_vbus_type(struct mainchg *bq)
+{
+	SHENG_CONSUMER_STATE(noti_data);
+	if (!noti_data)
+		return -EPROBE_DEFER;
+	struct read_mcu_data *mcu_data = READ_ONCE(mcu_received) ? &noti_data->mcu_msg.mcu_data : NULL;
+
+
+	u8 pd_flag = 0, dpdm_in_ready = 0;
+
+	if (mcu_data) {
+		if (object == 0x38) {
+			pd_flag = (mcu_data->typec_state & BIT(2));
+			dpdm_in_ready = (mcu_data->dpdm_in_state & BIT(7));
+		} else {
+			pd_flag = (mcu_data->typec_state & 0x10);
+		}
+
+		if (pd_flag) {
+			noti_data->pd_msg.pd_active = pd_flag ? 1 : 0;
+		}
+
+		if (!dpdm_in_ready) {
+			main_err("%s need wait finish bc1.2 . \n", __func__);
+			return XM_VBUS_UNKNOWN;
+		}
+
+		bq->vbus_type = mcu_data->dpdm0_state;
+	} else {
+		main_err("%s gobal mcu data is null. \n", __func__);
+		return 0;
+	}
+
+	return bq->vbus_type;
+}
+
+static int xm_get_chg_usb_type(struct mainchg *bq)
+{
+	SHENG_CONSUMER_STATE(noti_data);
+	if (!noti_data)
+		return -EPROBE_DEFER;
+
+	u8 val;
+	int type;
+
+	val = xm_get_vbus_type(bq);
+	type = (int)val;
+	main_info("%s type=%d, old_type=%d \n", __func__, type, bq->old_type);
+
+	if (object == 0x3B) {
+		if (noti_data->pd_msg.pd_active) {
+			bq->charge_type = POWER_SUPPLY_USB_TYPE_PD;
+		} else
+			bq->charge_type = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+	}
+
+	main_info("%s charge_type=%d\n", __func__, bq->charge_type);
+
+	return 0;
+}
