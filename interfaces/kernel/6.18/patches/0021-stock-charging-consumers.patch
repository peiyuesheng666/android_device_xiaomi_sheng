+static void xm_first_irq_workfunc(struct work_struct *work)
+{
+	SHENG_CONSUMER_STATE(noti_data);
+	if (!noti_data)
+		return;
+	struct read_mcu_data *mcu_data = READ_ONCE(mcu_received) ? &noti_data->mcu_msg.mcu_data : NULL;
+
+
+	struct mainchg *bq = container_of(work, struct mainchg, first_irq_work.work);
+	static int first_dcin_count, first_mcu_count;
+
+	if ((first_dcin_count > 50) || (first_mcu_count > 50)) {
+		main_info("%s get dcin or mcu over 50\n", __func__);
+		return;
+	}
+	{
+ int queried = qti_get_DCIN_STATE();
+ if (queried < 0) {
+  if (!READ_ONCE(bq->stopping)) schedule_delayed_work(&bq->first_irq_work, msecs_to_jiffies(400));
+  return;
+ }
+ dc_in = queried;
+}
+ {
+  u8 detected;
+  if (!Nanosic_ADSP_Get_Object(&detected))
+   WRITE_ONCE(noti_data->mcu_msg.object_type, detected);
+ }
+	noti_data->irq_msg.value = dc_in;
+	main_err("%s: start first_irq_work, dcin state:%d\n", __func__, dc_in);
+	if (bq && dc_in) {
+		if (mcu_data) {
+			qti_deal_report();
+			if (!READ_ONCE(bq->stopping)) schedule_delayed_work(&bq->handler_adsp_work, 0);
+			main_info("%s: start irq_work\n", __func__);
+		} else {
+			if (noti_data->mcu_msg.object_type) {
+				if (noti_data->mcu_msg.object_type == 0x3B) {
+					mutex_lock(&noti_data->notify_lock);
+					noti_data->mcu_msg.object_type = 0x3B;
+					noti_data->mcu_msg.msg_type = BATTMNGR_MSG_MCU_TYPE;
+					battmngr_notifier_call_chain(BATTMNGR_EVENT_MCU, noti_data);
+					mutex_unlock(&noti_data->notify_lock);
+				}
+			}
+			if (!READ_ONCE(bq->stopping)) schedule_delayed_work(&bq->first_irq_work, msecs_to_jiffies(400));
+			first_mcu_count++;
+			main_info("%s mcu_data is null, send noti, first_mcu_count:%d\n", __func__, first_mcu_count);
+		}
+	} else if (noti_data->mcu_msg.object_type == 0x3B) {
+		if (!READ_ONCE(bq->stopping)) schedule_delayed_work(&bq->first_irq_work, msecs_to_jiffies(400));
+		first_dcin_count++;
+		main_info("%s dc_in is null, wait, first_dcin_count:%d\n", __func__, first_dcin_count);
+	} else if (noti_data->mcu_msg.object_type == 0x38) {
+		qti_set_keyboard_plugin(1);
+		main_info("%s keyboard already plugin, move mos to manual\n", __func__);
+	}
+}
