+/** ************************************************************************
+ *  @func Nanosic_Calculate_crc
+ *
+ *  @brief calculate sum
+ *
+ ** */
+static __maybe_unused
+uint8_t Nanosic_Calculate_crc(uint8_t* data,uint32_t datalen)
+{
+    uint8_t i=0;
+    uint8_t crc = 0;
+
+    for(i=2;i<datalen;i++) /*fixed bug in 2023.6.15*/
+        crc += data[i];
+
+    return crc;
+}
