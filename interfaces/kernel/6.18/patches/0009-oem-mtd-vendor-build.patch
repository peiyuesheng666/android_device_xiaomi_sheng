 obj-m += qcom_logbuf_vh.o
 qcom_logbuf_vh-y := drivers/soc/qcom/qcom_logbuf_vendor_hooks.o
 ccflags-y += -include $(M)/gen/autoconf_vendor.h
--- /dev/null
