+static int load_default_backing_prog(void)
+{
+	const struct bpf_insn prog[] = {
+		FUSE_BPF_MOV64_IMM(BPF_REG_0, FUSE_BPF_BACKING),
+		FUSE_BPF_EXIT_INSN(),
+	};
+
+	return load_fuse_bpf_prog(prog, ARRAY_SIZE(prog));
+}
