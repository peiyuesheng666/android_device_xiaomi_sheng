+	bfd = open(back_file, O_CREAT | O_RDWR | O_TRUNC | O_CLOEXEC, 0644);
+	ASSERT_GE(bfd, 0);
+	close_fd(&bfd);
+
+	prog_fd = load_fuse_bpf_prog(redact_prog, ARRAY_SIZE(redact_prog));
+	ASSERT_GE(prog_fd, 0);
+	__atomic_store_n(&self->bpf_fd, prog_fd, __ATOMIC_SEQ_CST);
