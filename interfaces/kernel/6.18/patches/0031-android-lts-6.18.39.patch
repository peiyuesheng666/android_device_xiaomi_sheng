+            events[slot] = Some(EventInfo::new(fd));
+            return Ok(slot);
+        }
+
+        let slot = events.len();
+        events.push(Some(EventInfo::new(fd)), GFP_KERNEL)?;
+
+        Ok(slot)
+    }
+
+    pub(crate) fn free_slot(&self, slot: usize) -> Result<()> {
+        let mut guard = self.events.lock();
+        if slot >= guard.len() || guard[slot].is_none() {
+            return Err(ERANGE);
+        }
+
+        guard[slot] = None;
+
+        Ok(())
+    }
