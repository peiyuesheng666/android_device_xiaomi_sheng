+#[pin_data(PinnedDrop)]
+pub(crate) struct FileMonitor {
+    #[pin]
+    wait_queue_head: Opaque<bindings::wait_queue_head>,
+    events_pending: AtomicBool,
+
+    #[pin]
+    events: Mutex<EventVector>,
+
+    #[pin]
+    _pin: PhantomPinned,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) enum ProcessMode {
+    Add,
+    Delete,
