+#[derive(Default)]
+struct EventInfo {
+    fd: u32,
+    monitored: u32,
+    triggered: u32,
+    timestamp: u64,
+}
+
+impl EventInfo {
+    fn new(fd: u32) -> Self {
+        Self {
+            fd,
+            monitored: 0,
+            triggered: 0,
+            timestamp: 0,
+        }
+    }
