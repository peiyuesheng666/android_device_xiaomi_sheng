--- a/soc/drivers/clk/qcom/dispcc-kalama.c
+++ b/soc/drivers/clk/qcom/dispcc-kalama.c
@@ -1974,9 +1974,12 @@
 				stage, regs[i], value);
 }
 
+static bool sheng_dispcc_live_splash;
+
 static int disp_cc_kalama_probe(struct platform_device *pdev)
 {
 	struct regmap *regmap;
+	unsigned int mdp_branch;
 	int ret;
 
 	regmap = qcom_cc_map(pdev, &disp_cc_kalama_desc);
@@ -1992,13 +1995,24 @@
 		return ret;
 
 	sheng_dispcc_trace(&pdev->dev, "firmware");
+	/* The bootloader is scanning out before RSC and the display driver bind.
+	 * CCF holds this clock by calling its .enable(), which would otherwise
+	 * add HW_CLK_CTRL to an already-running firmware RCG. Retain the
+	 * firmware software-controlled gate until consumers have taken over. */
+	ret = regmap_read(regmap, 0x800c, &mdp_branch);
+	if (ret)
+		goto put_runtime;
+	sheng_dispcc_live_splash = !!(mdp_branch & BIT(0));
+	if (sheng_dispcc_live_splash)
+		disp_cc_mdss_mdp_clk_src.flags &= ~HW_CLK_CTRL_MODE;
 	clk_lucid_ole_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
 	clk_lucid_ole_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
 
 	sheng_dispcc_trace(&pdev->dev, "after-pll");
 
 	/* Enable clock gating for MDP clocks */
-	regmap_update_bits(regmap, DISP_CC_MISC_CMD, 0x10, 0x10);
+	if (!sheng_dispcc_live_splash)
+		regmap_update_bits(regmap, DISP_CC_MISC_CMD, 0x10, 0x10);
 
 	/*
 	 * Keep clocks always enabled:
@@ -2014,6 +2028,7 @@
 	}
 
 	sheng_dispcc_trace(&pdev->dev, "registered");
+put_runtime:
 	pm_runtime_put_sync(&pdev->dev);
 	dev_info(&pdev->dev, "Registered DISP CC clocks\n");
 
@@ -2022,6 +2037,26 @@
 
 static void disp_cc_kalama_sync_state(struct device *dev)
 {
+	struct regmap *map;
+	int ret;
+
+	if (sheng_dispcc_live_splash) {
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret < 0) {
+			dev_err(dev, "failed to finish splash clock takeover: %d\n", ret);
+			return;
+		}
+		map = dev_get_regmap(dev, NULL);
+		/* Future normal RCG rate updates may now enable HW control. Do not
+		 * issue an extra live RCG update just to change its gate mode. */
+		disp_cc_mdss_mdp_clk_src.flags |= HW_CLK_CTRL_MODE;
+		regmap_update_bits(map, DISP_CC_MISC_CMD, BIT(4), BIT(4));
+		sheng_dispcc_trace(dev, "consumers-bound");
+		sheng_dispcc_live_splash = false;
+		qcom_cc_sync_state(dev, &disp_cc_kalama_desc);
+		pm_runtime_put_sync(dev);
+		return;
+	}
 	qcom_cc_sync_state(dev, &disp_cc_kalama_desc);
 }
 
