diff --git a/tools/clean_headers.sh b/tools/clean_headers.sh
index 3a12160..00c1d28 100755
--- a/tools/clean_headers.sh
+++ b/tools/clean_headers.sh
@@ -3,7 +3,16 @@ set -eu
 
 export ANDROID_BUILD_TOP="$PWD"
 
+# Resolve once so the cleaner never interprets a build output as an input header.
+header_root=$(realpath -e -- "$1")
+for header in asm/signal.h asm-generic/signal.h linux/eventpoll.h; do
+    if [[ ! -s "$header_root/usr/include/$header" ]]; then
+        echo "Missing generated kernel header: $header_root/usr/include/$header" >&2
+        exit 1
+    fi
+done
+
 ./bionic/libc/kernel/tools/clean_header.py -u \
-    "$1/usr/include/asm/signal.h" \
-    "$1/usr/include/asm-generic/signal.h" \
-    "$1/usr/include/linux/eventpoll.h"
+    "$header_root/usr/include/asm/signal.h" \
+    "$header_root/usr/include/asm-generic/signal.h" \
+    "$header_root/usr/include/linux/eventpoll.h"
