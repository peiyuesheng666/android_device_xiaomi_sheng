// SPDX-License-Identifier: Apache-2.0
// Development application only; intentionally absent from PRODUCT_PACKAGES.
package {
    default_applicable_licenses: ["sheng_face_lab_license"],
}

license {
    name: "sheng_face_lab_license",
    visibility: ["//device/xiaomi/sheng/interfaces/biometrics:__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

android_app {
    name: "ShengFaceLab",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    sdk_version: "current",
    min_sdk_version: "30",
    product_specific: true,
    optimize: { enabled: false },
}

// Shared, source-owned capture/engine classes for the system integration.
filegroup {
    name: "sheng-face-capture-sources",
    srcs: ["src/**/*.java"],
    visibility: ["//device/xiaomi/sheng/interfaces/biometrics/systemface:__pkg__"],
}

filegroup {
    name: "sheng-native-face-math-sources",
    srcs: [
        "src/org/lineageos/sheng/facelab/FaceEmbedding.java",
        "src/org/lineageos/sheng/facelab/FaceDescriptor.java",
        "src/org/lineageos/sheng/facelab/SampleCollector.java",
    ],
    visibility: ["//device/xiaomi/sheng/interfaces/biometrics/systemface/native:__pkg__"],
}

filegroup {
    name: "sheng-native-face-engine-sources",
    srcs: [
        "src/org/lineageos/sheng/facelab/OpenCvEngine.java",
        "src/org/lineageos/sheng/facelab/FrameMath.java",
        "src/org/lineageos/sheng/facelab/EnrollmentFraming.java",
        "src/org/lineageos/sheng/facelab/FaceLandmarkPose.java",
    ],
    visibility: ["//device/xiaomi/sheng/interfaces/biometrics/systemface:__pkg__"],
}
