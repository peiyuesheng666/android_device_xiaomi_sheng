# Keep app-visible hardware identity separate from the marketing name.
ro.product.model=24018RPACC
ro.product.marketname=Xiaomi Pad 6S Pro 12.4

# First-boot time zone; persisted user selections take precedence on later boots.
persist.sys.timezone=Asia/Shanghai

# The bundled tablet Pixel Launcher embeds private framework resource IDs from
# another framework revision. Its desktop eligibility ID resolves to
# config_hideNavBarForKeyboard here. Use the supported eligibility override;
# sheng_desktop_enabled still controls whether the internal display uses windows.
persist.wm.debug.desktop_mode_enforce_device_restrictions=false

# Keep block-backed APEX mounts while sheng uses overlayfs on /product.
# The file-backed probe on /system does not cover APEX files on that overlay.
apexd.config.erofs_file_backed_mount=false

# CameraX
ro.camerax.extensions.enabled=true

# HWUI
debug.hwui.skia_atrace_enabled=false
ro.hwui.drop_shadow_cache_size=6
ro.hwui.gradient_cache_size=1
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.r_buffer_cache_size=8
ro.hwui.text_large_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_small_cache_height=1024
ro.hwui.text_small_cache_width=1024
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.texture_cache_size=72

# IMS

# Media
media.settings.xml?=/odm/etc/media_profiles_kalama.xml

# RIL
