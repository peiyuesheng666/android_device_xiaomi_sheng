+static int sheng_nano_flush_caps_locked(struct nanosic_wn8030 *nano)
+{
+ bool on = READ_ONCE(nano->panel_state) == SHENG_NANO_PANEL_ON &&
+           nano->panel_state_sent == SHENG_NANO_PANEL_ON;
+ bool sent;
+ int ret;
+ lockdep_assert_held(&nano->io_lock);
+ if (!sheng_nano_caps_pending(&nano->caps, on,
+       nano->ready && !nano->suspended && !nano->removing))
+  return 0;
+ sent = nano->caps.desired;
+ ret = nanosic_wn8030_set_caps_led(nano, sent);
+ if (!ret)
+  sheng_nano_caps_commit(&nano->caps, sent);
+ return ret;
+}
