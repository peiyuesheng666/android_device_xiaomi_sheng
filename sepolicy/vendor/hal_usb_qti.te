# Usb.cpp enumerates /sys/class/udc after a UDC remove event. If opendir()
# fails, it treats the directory as empty and disables USB ADB even when
# another UDC remains. The common sm8550 policy only permits directory search.
allow vendor_hal_usb_qti sysfs_udc:dir r_dir_perms;

# sheng labels port0/data_role as vendor_sysfs_usb_supply for batterysecret.
# The USB HAL also writes this node for the supported source/host pairing.
allow vendor_hal_usb_qti vendor_sysfs_usb_supply:file write;
