on early-init
    # Default to the same ADB mode as Recovery's "Enable ADB" action.
    # This property is read only by the Recovery build of adbd.
    setprop ro.adb.secure.recovery 0
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    # Match the accepted sheng standalone Recovery firmware path. Retry the
    # mount in fs after coldboot if the modem partition is not available yet.
    mkdir /firmware 0755 root root
    mount vfat /dev/block/by-name/modem${ro.boot.slot_suffix} /firmware ro context=u:object_r:firmware_file:s0
    write /sys/module/firmware_class/parameters/path /firmware/image
    start sheng-recovery-hardware

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1
    symlink /dev/sheng-recovery-hardware.log /tmp/sheng-recovery-hardware.log

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # PMIC battery supplies depend on ADSP and the complete modem firmware.
    mkdir /firmware 0755 root root
    wait /dev/block/by-name/modem${ro.boot.slot_suffix} 5
    mount vfat /dev/block/by-name/modem${ro.boot.slot_suffix} /firmware ro context=u:object_r:firmware_file:s0
    write /sys/module/firmware_class/parameters/path /firmware/image
    start sheng-recovery-hardware

service sheng-recovery-hardware /system/bin/sh /system/bin/sheng-recovery-hardware
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:init.svc.fastbootd=running
    umount /firmware
